# Auto-detect text; normalize to LF in the repo.
* text=auto eol=lf

# C# / config stay text
*.cs text diff=csharp
*.asmdef text
*.asmref text
*.json text
*.md text
*.xml text
*.yaml text
*.yml text
*.txt text
